{
  "name": "hint-native",
  "displayName": "Hint - AI Prompt Assistant (Native)",
  "version": "1.0.2",
  "description": "An AI assistant for writing prompts - Native implementation with React",
  "author": "royzeng",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n reload,popup,background,content -c yellow,cyan,magenta,green \"node scripts/reload-server.mjs\" \"pnpm dev:popup\" \"pnpm dev:background\" \"pnpm dev:content\"",
    "dev:init": "pnpm build && pnpm dev",
    "dev:popup": "vite build --watch --mode development",
    "dev:background": "vite build --watch --mode development --config vite.background.config.ts",
    "dev:content": "vite build --watch --mode development --config vite.content.config.ts",
    "build": "rm -rf dist && tsc && vite build && vite build --config vite.background.config.ts && vite build --config vite.content.config.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.553.0",
    "openai": "^4.95.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.28",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "chokidar": "^4.0.3",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "ws": "^8.18.3"
  }
}
